{
  "name": "sticker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx --watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "mcp": "node dist/server/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/ui/*.test.ts tests/ui/*.test.tsx && node --test tests/access-runtime.test.mjs",
    "test:ui": "playwright test",
    "format:check": "prettier --check \"{server,client,tests}/**/*.{ts,tsx,css,mjs}\" \"*.{ts,mjs,json,html,yaml}\" \"{README.md,docs/**/*.md}\" \".github/workflows/*.{yml,yaml}\"",
    "test:production": "node tests/production-smoke.mjs && node tests/compiled-maintenance-smoke.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:report": "eslint . --max-warnings 0 --format json --output-file lint-report.json",
    "test:lint": "node --test tests/lint-config.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "multer": "2.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
