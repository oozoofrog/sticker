# REQUIRED: choose your own unique secret, 12–1024 characters.
# No default owner password or agent token is shipped.
OWNER_PASSWORD=

# Keep the default loopback binding. If changing STICKER_PORT, update APP_ORIGIN.
STICKER_PORT=8787
APP_ORIGIN=http://localhost:8787
SECURE_COOKIES=false

# Optional agents: use -f compose.yaml -f compose.agents.yaml (see docs/MCP.md).
# The base install has no host config mount. Supply your own existing JSON file.
# STICKER_AGENT_CONFIG=./config/agents.json
# AGENT_CONFIG_PATH=/app/config/agents.json
AGENT_CONFIG_PATH=

# Optional GitHub evidence provider. No network or credential file reads by default.
GITHUB_READ_ENABLED=false
# Operator-created read-only mounted credential reference file; never commit it.
# GITHUB_CREDENTIAL_CONFIG_PATH=/app/config/github-credentials.json
GITHUB_CREDENTIAL_CONFIG_PATH=
